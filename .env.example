# =====================================================================
# SwiftTrack — Environment Variable Reference
# =====================================================================
# Copy this file to .env to override defaults before running:
#   cp .env.example .env
#
# Container-to-container communication always uses internal ports.
# The variables below only affect the HOST-side port bindings and
# application-level secrets.
# =====================================================================

# ── Host-side port overrides ──────────────────────────────────────────
# Useful when the default ports conflict with other local services.
# API_GATEWAY_HOST_PORT=3100
# CLIENT_PORTAL_HOST_PORT=8180
# DRIVER_PORTAL_HOST_PORT=18081

# ── JWT configuration ─────────────────────────────────────────────────
# Change JWT_SECRET to a long random string in any non-classroom env.
# Generate one with: openssl rand -hex 32
JWT_SECRET=swiftlogistics-secret-key-2026
JWT_EXPIRES_IN=8h

# ── Demo driver password ──────────────────────────────────────────────
# Password used for the seeded driver accounts (kasun@, nimal@).
# Default is "password123". Override for any non-demo deployment.
# DEMO_DRIVER_PASSWORD=password123

# ── Database (internal service URL — do not change for Docker Compose) ─
# DATABASE_URL=postgresql://swift_admin:swift_pw_dev_only@postgres:5432/swifttrack

# ── RabbitMQ (internal service URL — do not change for Docker Compose) ─
# RABBITMQ_URL=amqp://swift_admin:swift_pw_dev_only@rabbitmq:5672

# ── Downstream service URLs (resolved by Docker DNS inside the stack) ──
# CMS_SOAP_URL=http://cms-service:8001/soap
# CMS_REST_URL=http://cms-service:8001
# ROS_REST_URL=http://ros-service:8002
# WMS_TCP_HOST=wms-service
# WMS_TCP_PORT=9000

# ── Gateway timeout (ms) for downstream calls ─────────────────────────
# DOWNSTREAM_TIMEOUT_MS=5000
